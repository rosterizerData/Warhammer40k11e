      "Stratagem§Ground-shaking Strides": {
        "text": "**WHEN:** Your Movement phase, when a friendly **IMPERIAL KNIGHTS DOMINUS** unit is **selected to move**.\n\n**TARGET:** That **IMPERIAL KNIGHTS DOMINUS** unit.\n\n**EFFECT:** Your unit has +2\" **M**.",
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Dominus Foebreakers"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Movement"
          ]
        }
      },
      "Stratagem§Foebreaker Firestorm": {
        "text": "**WHEN:** Your Shooting phase, when a friendly **engaged** **IMPERIAL KNIGHTS DOMINUS** unit is **selected to shoot**.\n\n**TARGET:** That **IMPERIAL KNIGHTS DOMINUS** unit.\n\n**EFFECT:** Your unit’s **[BLAST]** ranged attacks:\n\n- Do not have **[BLAST]**.\n\n- Have +1 **A**.",
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Dominus Foebreakers"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Shooting"
          ]
        }
      },
      "Stratagem§Fire Shocked": {
        "text": "**WHEN:** Your Shooting phase, when a friendly **IMPERIAL KNIGHTS DOMINUS** unit has shot.\n\n**TARGET:** That **IMPERIAL KNIGHTS DOMINUS** unit.\n\n**EFFECT:** Select one enemy unit hit by those attacks. That enemy unit makes a **battle-shock roll**, with -1 to that **battle-shock roll**.",
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Dominus Foebreakers"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Shooting"
          ]
        }
      },
