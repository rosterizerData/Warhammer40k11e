          ]
        },
        "text": "The bearer has a Save characteristic of 2+.",
        "stats": {
          "Crusade Pts": {
            "value": 2
          }
        }
      },
      "Crusade Relic§Helm of the Nameless Warrior": {
        "keywords": {
          "Tags": [
            "Legendary Relic"
          ]
        },
        "text": "Melee weapons equipped by the bearer have the **[DEVASTATING WOUNDS]** ability.",
        "stats": {
