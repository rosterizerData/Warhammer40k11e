                    "{roster}",
                    "constraints",
                    "any"
                  ]
                ],
                "value": "Astra Militarum"
              },
              {
                "actionType": "remove",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "stats",
                    "Allied faction 1",
                    "ranks"
                  ]
                ],
                "value": "Astra Militarum"
              }
            ],
            "evals": [
