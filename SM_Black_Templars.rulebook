        "stats": {
          "Relic Fragments gained": {
            "statType": "numeric",
            "value": 0,
            "visibility": "normal",
            "dynamic": true,
            "increment": {
              "value": 1
            },
            "min": 0,
            "max": 99,
            "icons": [
              "shield"
            ],
            "statOrder": 1
          },
          "Relic Fragments remaining": {
            "statType": "numeric",
            "value": 0,
            "visibility": "normal",
            "min": -99,
            "max": 99,
            "statOrder": 2
          }
        },
        "rules": {
          "relicFragmentsRemaining": {
            "actions": [
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{self}",
                    "stats",
                    "Relic Fragments remaining",
                    "value"
                  ]
                ],
                "value": [
                  "{this}",
                  "evals",
                  "0",
                  "result",
                  "integer"
                ]
              }
            ],
            "evals": [
              {
                "actionable": true,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{self}",
                    "stats",
                    "Relic Fragments gained",
                    "value"
                  ]
                ],
                "equation": {
                  "operator": "T-O",
                  "value": [
                    "{roster}",
                    "tracked",
                    "Relic Fragments"
                  ]
                }
              }
            ],
            "evaluate": "AND",
            "failState": "pass",
            "order": 1,
            "note": "gained minus the Relic Fragments spent on Reclaimed Relics"
          },
          "Your Reclaimed Relics cost more Relic Fragments than your Crusade force has gained.": {
            "evals": [
              {
                "actionable": true,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{self}",
                    "stats",
                    "Relic Fragments remaining",
                    "value"
                  ]
                ],
                "min": 0
              }
            ],
            "evaluate": "AND",
            "failState": "error",
            "order": 5
          }
        }
      },
