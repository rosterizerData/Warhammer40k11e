                ],
                "value": "Stratagem§Devout Push"
              }
            ],
            "evals": [],
            "evaluate": "AND",
            "failState": "pass"
          }
        }
      },
      "Stratagem§Slayers of Abominations": {
        "text": "**WHEN:** Fight phase, when a friendly **SWORD BRETHREN SQUAD** unit is **selected to fight**.\n\n**TARGET:** That **SWORD BRETHREN SQUAD** unit.\n\n**EFFECT:** Your unit's melee attacks that target a **MONSTER/VEHICLE** unit have +2 **S**.",
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Marshal's Household"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight"
          ]
        }
      },
      "Stratagem§Unsparing Execution": {
        "text": "**WHEN:** Your opponent's Movement phase, when a unit is selected to make a **fall-back move**, if that unit is **engaged** with a friendly **SWORD BRETHREN SQUAD ** unit.\n\n**TARGET:** That **SWORD BRETHREN SQUAD** unit.\n\n**EFFECT:** When an enemy unit **engaged** with your unit is selected to make a **fall-back move **, that enemy unit must use the **desperate escape** mode, with -1 to those **hazard rolls** if that enemy unit is **battle-shocked**.",
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Marshal's Household"
          ],
          "Turn": [
            "Opponent’s"
          ],
          "Phase": [
            "Movement"
          ]
        }
      },
      "Stratagem§Blade of Detestation": {
        "text": "**WHEN:** Your Charge phase, when a friendly **SWORD BRETHREN SQUAD** unit ends a **charge move**.\n\n**TARGET:** That **SWORD BRETHREN SQUAD**.\n\n**EFFECT:** Select one enemy unit **engaged** with your unit. Roll one D6 for each model in your unit **engaged** with that enemy unit:\n- For each 4+, that enemy unit suffers 1 **mortal wound** (to a maximum of 6 **mortal wounds**).",
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Marshal's Household"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Charge"
          ]
        }
      },
      "Stratagem§Doctrinal Flexibility": {
        "text": "**WHEN:** Your Command phase.\n\n**TARGET:** One friendly **CRUSADER SQUAD** unit.\n\n**EFFECT:** Select one **combat doctrine**. That **combat doctrine** is active for your unit until the start of your next Command phase.",
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Fist of the God-Emperor"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Command"
          ]
        }
      },
      "Stratagem§Angels Defiant": {
        "text": "**WHEN:** Your opponent’s Shooting phase or the Fight phase, when an enemy unit targets a friendly **CRUSADER SQUAD** unit.\n\n**TARGET:** That **CRUSADER SQUAD** unit.\n\n**EFFECT:** Attacks that target your unit with a **S** greater than your unit’s **T** have -1 to **wound rolls**.",
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Fist of the God-Emperor"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight",
            "Shooting"
          ]
        }
      },
      "Stratagem§Avowed Destruction": {
        "text": "**WHEN:** The Fight phase, when a friendly **CRUSADER SQUAD** unit is **selected to fight**.\n\n**TARGET:** That **CRUSADER SQUAD** unit.\n\n**EFFECT:** Your unit’s melee attacks: \n- Have **[LETHAL HITS]**.\n- __Or:__ Have **[SUSTAINED HITS 1]**.",
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Fist of the God-Emperor"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight"
          ]
        }
      },
      "Stratagem§For the Emperor's Honour!": {
        "text": "**WHEN:** The Fight phase, when a friendly **ADEPTUS ASTARTES INFANTRY** unit is **selected to fight**.\n\n**TARGET:** That **ADEPTUS ASTARTES INFANTRY** unit.\n\n**EFFECT:** Your unit’s melee attacks have **[PRECISION]**.",
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Vow-sworn Crusaders"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight"
          ]
        }
      },
      "Enhancement§Righteous Fervour (Upgrade)": {
        "text": "**CRUSADER SQUAD** unit only. This unit can re-roll **Advance rolls**.",
        "keywords": {
          "Keywords": [
            "Fist of the God-Emperor"
          ],
          "Tags": [
            "Upgrade"
          ]
        },
        "stats": {
