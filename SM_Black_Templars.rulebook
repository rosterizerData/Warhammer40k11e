      "Detachment§Marshal's Household": {
        "keywords": {
          "Role": [
            "Priority Assets"
          ]
        },
        "stats": {
          "Detachment Points": {
            "value": 1
          }
        },
        "text": "**FAITH-FUELLED RESOLVE**\n\nIn the Fight phase, if a friendly **SWORD BRETHREN SQUAD** unit is within range of an **objective**, that unit’s melee attacks have +1 **A**.\n\n**Restrictions:** Your army can include **BLACK TEMPLARS** units, but it cannot include any **ADEPTUS ASTARTES** units drawn from any other Chapter.",
        "rules": {
          "assignStratagems": {
            "actions": [
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "traits",
                    "item",
                    "Stratagems§Stratagems",
                    "traits"
                  ]
                ],
                "value": "Stratagem§Slayers of Abominations"
              },
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "traits",
                    "item",
                    "Stratagems§Stratagems",
                    "traits"
                  ]
                ],
                "value": "Stratagem§Unsparing Execution"
              },
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "traits",
                    "item",
                    "Stratagems§Stratagems",
                    "traits"
                  ]
                ],
                "value": "Stratagem§Blade of Detestation"
              }
            ],
            "evals": [],
            "evaluate": "AND",
            "failState": "pass"
          }
        }
      },
      "Enhancement§Augury Servo-Host": {
        "keywords": {
          "Keywords": [
