      "Character§Autarch Wayleaper": {
        "assets": {
          "traits": [
            {
              "item": "Ability§Leader",
              "text": "This model can be attached to the following units:\n\n* Swooping Hawks\n\n* Warp Spiders"
            },
            "Ability§Deep Strike",
            "Ability§Battle Focus",
            "Ability§Indomitable Strength of Will",
