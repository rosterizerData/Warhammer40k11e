        "keywords": {
          "Source": [
            "10th Edition Codex"
          ],
          "Faction": [
            "Asuryani"
          ]
        },
        "assets": {
          "traits": [
            {
              "item": "Ability§Leader",
              "text": "This model can be attached to the following units:\n\n* Corsair Reaver Band\n\n* Corsair Voidreavers\n\n* Corsair Voidscarred"
            }
          ]
        },
        "removed": {
          "rules": {
            "noEpicHeroEnhancements": {}
          }
        },
        "rules": {
          "Epic Hero: only Archraider": {
            "evals": [
              {
                "actionable": true,
                "equation": {
                  "operator": "T-O",
                  "value": [
                    "{self}",
                    "tally",
                    "Archraider"
                  ]
                },
                "max": 0,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{self}",
                    "tally",
                    "Enhancement"
                  ]
                ]
              }
            ],
            "evaluate": "AND",
            "failState": "error",
            "note": "this Epic Hero may take only the enhancement(s) written for it"
          }
        }
      },
