        "rules": {
          "hideAllyPoints": {
            "actions": [
              {
                "actionType": "set",
                "iterations": 1,
                "note": "Harlequins are effectively a permanent ally for Aeldari, as they have a separate faction keyword but an army rule that allows them anyway. They don't *really* count as an ally and there's no need to show their points subtotal - they're included as an ally purely as a convenient way of allowing their units.",
