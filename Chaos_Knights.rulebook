      "Hunt Tactic§Aggressive Charge": {
        "keywords": {
          "Tags": [
            "Chaos Knights"
          ],
          "Keywords": [
            "Hunt Tactic"
          ]
        },
        "text": "This model is eligible to declare a charge in a turn in which it Advanced. In addition, if this model’s Hunting Pack is Ascendant, each time this model makes a melee attack, if it made a Charge move this turn, that attack has the [DEVASTATING WOUNDS] ability."
      },
      "Hunt Tactic§Pin and Predate": {
        "keywords": {
          "Tags": [
            "Chaos Knights"
          ],
          "Keywords": [
            "Hunt Tactic"
          ]
        },
        "text": "Each time this model makes a melee attack, you can re-roll a Wound roll of 1. If this model’s Hunting Pack is Ascendant, you can re-roll the Wound roll instead."
      },
      "Hunt Tactic§Roving Assassins": {
        "keywords": {
          "Tags": [
            "Chaos Knights"
          ],
          "Keywords": [
            "Hunt Tactic"
          ]
        },
        "text": "Add 3\" to the Range characteristic of ranged weapons equipped by this model. In addition, if this model’s Hunting Pack is Ascendant, ranged weapons equipped by this model have the [IGNORES COVER] ability."
      },
      "Hunt Tactic§Brute Tactics": {
        "keywords": {
          "Tags": [
            "Chaos Knights"
          ],
          "Keywords": [
            "Hunt Tactic"
          ]
        },
        "text": "This model has a 5+ invulnerable save against melee attacks. In addition, if this model’s Hunting Pack is Ascendant, each time this model ends a Charge move, select one enemy unit within Engagement Range of it and roll one D6: on a 2+, that enemy unit suffers D3 mortal wounds."
      },
      "Hunt Tactic§Hidden Stalkers": {
        "keywords": {
          "Tags": [
            "Chaos Knights"
          ],
          "Keywords": [
            "Hunt Tactic"
          ]
        },
        "text": "This model has the Benefit of Cover. In addition, if this model’s Hunting Pack is Ascendant, this model can only be targeted by a ranged attack if the attacking model is within 18\"."
      },
