      "Battle Trait§Extreme Methods": {
        "keywords": {
          "Tags": [
            "Character"
          ]
        },
        "text": "This model's weapons have the **[DEVASTATING WOUNDS]** ability and, if this model is an **^^Inquisitor^^**, it gains the **^^Radical^^** keyword. In addition, if this model is your **^^Warlord^^**, at the end of the battle, you gain 1 additional Intrigue point. If this model gains the **^^Puritan^^** keyword for any reason, it immediately loses this Battle Trait and the **^^Radical^^** keyword."
      },
      "Battle Trait§Brotherhood of Veterans": {
        "keywords": {
          "Tags": [
            "Deathwatch"
          ]
        },
        "text": "At the end of the battle, you can remove one or more Battle Honours that this unit has (except for this one). For each Battle Honour removed, you can immediately select a new Battle Honour for this unit."
      },
      "Battle Trait§Unwavering Enmity": {
        "keywords": {
          "Tags": [
            "Deathwatch"
          ]
        },
        "text": "Each time a model in this unit makes an attack that targets a unit that does not have either the **^^Imperium^^** or **^^Chaos^^** keywords, that attack has the **[LETHAL HITS]** ability."
      },
      "Battle Trait§Tenacious Hunters": {
        "keywords": {
          "Tags": [
            "Deathwatch"
          ]
        },
        "text": "This unit has the Infiltrators ability. At the end of a battle, if one or more units with this Battle Trait are wholly within 6\" of your opponent's battlefield edge, you gain 1 Influence points."
      },
      "Battle Trait§Ruthless Interrogators": {
        "keywords": {
          "Tags": [
            "Inquisitorial Agents"
          ]
        },
        "text": "Each time a model in this unit makes a melee attack re-roll a Hit roll of 1. At the end of the battle, if one or more enemy **^^Character^^** models were destroyed by melee attacks during that battle, and one or more units with this Battle Trait were on the battlefield at the end of the battle, you gain 1 Investigation point."
      },
      "Battle Trait§Artful Operatives": {
        "keywords": {
          "Tags": [
            "Inquisitorial Agents"
          ]
        },
        "text": "During the Declare Battle Formations step, select either the Infiltrators, Scouts 6\" or Deep Strike ability. Until the end of the battle, this unit has the selected ability."
      },
      "Battle Trait§Devotion to the Throne": {
        "keywords": {
          "Tags": [
            "Inquisitorial Agents"
          ]
        },
        "text": "Each time this unit is Marked for Greatness, it gains an additional 2XP. For each unit from your Crusade army with this Battle Trait that is on the battlefield at the end of the battle, roll one D6: for each 6, you gain either 1 Intrigue point or 1 Influence point."
      },
      "Battle Trait§Response Officers": {
